<IfModule mod_rewrite.c>
    RewriteEngine On
    
        # Bloquear acceso directo a archivos y carpetas sensibles de laravel_app
            RewriteRule ^laravel_app/(app|bootstrap|config|database|resources|routes|storage|tests|vendor)/ - [F,L]
                RewriteRule ^laravel_app/\.env$ - [F,L]
                    RewriteRule ^laravel_app/(composer\.(json|lock)|\.env.*|artisan)$ - [F,L]
                    
                        RewriteCond %{HTTP:Authorization} .
                            RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
                            
                                RewriteCond %{REQUEST_FILENAME} !-d
                                    RewriteCond %{REQUEST_URI} (.+)/$
                                        RewriteRule ^ %1 [L,R=301]
                                        
                                            RewriteCond %{REQUEST_FILENAME} !-d
                                                RewriteCond %{REQUEST_FILENAME} !-f
                                                    RewriteRule ^ index.php [L]
                                                    </IfModule>